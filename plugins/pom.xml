<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kill-bill.billing</groupId>
        <artifactId>killbill-oss-parent</artifactId>
        <version>0.147.21-SNAPSHOT</version>
        <relativePath>../killbill-oss-parent/pom.xml</relativePath>
    </parent>
    <artifactId>killbill-plugins</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Kill Bill Plugins</name>
    <description>Plugins built against the LPR runtime.

        These are ports of the plugins that previously shipped as OSGi bundles. A port is not a
        repackaging: the OSGi Activator, its ServiceTracker wrappers and the bnd instructions that
        generated the bundle manifest all go away, replaced by a Plugin implementation and a
        plugin.yaml. What stays is the part that was always the plugin's own business -- the
        PaymentPluginApi, InvoicePluginApi and friends.</description>

    <modules>
        <module>hello-world-plugin</module>
        <module>hello-world-java-plugin</module>
        <module>stripe-plugin</module>
        <module>custom-email-invoice-formatter-plugin</module>
        <module>vertex-plugin</module>
        <module>gocardless-plugin</module>
        <module>adyen-plugin</module>
        <module>email-notifications-plugin</module>
        <module>avatax-plugin</module>
        <module>analytics-plugin</module>
        <module>currency-plugin</module>
        <module>deposit-plugin</module>
        <module>payment-test-plugin</module>
        <module>catalog-plugin-test</module>
        <module>metrics-plugin</module>
        <module>prometheus-plugin</module>
        <module>graphite-plugin</module>
        <module>influxdb-plugin</module>
        <module>eureka-plugin</module>
    </modules>
</project>
