<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kill-bill.billing</groupId>
        <artifactId>killbill-plugins</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>metrics-plugin</artifactId>
    <packaging>jar</packaging>
    <name>Metrics Plugin</name>
    <description>Supplies the MetricRegistry that Kill Bill and every other plugin meter into, plus
        the JVM metric sets, a JMX reporter and a deadlock healthcheck.

        Ported from killbill-platform-osgi-bundles-metrics. This one is load-bearing rather than
        optional: with no plugin publishing a MetricRegistry, the platform falls back to a no-op and
        every timer in Kill Bill silently records nothing.</description>

    <dependencies>
        <!-- provided, not compile: com.codahale.metrics types cross the plugin boundary (the
             platform's KillBillCodahaleMetricRegistry wraps one), so every side must resolve them
             from the same ClassLoader. Bundling a copy produces a ClassCastException between two
             classes with identical names. This is what the OSGi bundles' Import-Package achieved. -->
        <dependency>
            <groupId>io.dropwizard.metrics</groupId>
            <artifactId>metrics-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.dropwizard.metrics</groupId>
            <artifactId>metrics-jmx</artifactId>
            <version>${metrics.version}</version>
        </dependency>
        <dependency>
            <groupId>io.dropwizard.metrics</groupId>
            <artifactId>metrics-jvm</artifactId>
            <version>${metrics.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-testkit</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <!-- provided: org.killbill.* is parent-first, so bundling this would ship a class the
             plugin ClassLoader is not allowed to use anyway. -->
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-metrics</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
