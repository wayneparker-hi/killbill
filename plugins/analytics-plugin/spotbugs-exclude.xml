<FindBugsFilter>
    <!-- Reported by a newer SpotBugs than these plugins were written against; the patterns did not
         exist upstream. Pre-existing code, unrelated to the LPR migration. -->
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <!-- The three patterns above may not apply to every class here; a filter entry that
         matches nothing is itself reported, which is noise rather than a finding. -->
    <Bug pattern="US_USELESS_SUPPRESSION_ON_CLASS"/>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_FIELD"/>
    <Bug pattern="US_USELESS_SUPPRESSION_ON_METHOD"/>
    <Bug pattern="SS_SHOULD_BE_STATIC"/>
    <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    <Match>
        <Or>
            <Class name="org.killbill.billing.plugin.analytics.reports.KillBillBooleanExprLexer"/>
            <Class name="org.killbill.billing.plugin.analytics.reports.KillBillBooleanExprParser"/>
            <Class name="org.killbill.billing.plugin.analytics.reports.KillBillArithmeticExprLexer"/>
            <Class name="org.killbill.billing.plugin.analytics.reports.KillBillArithmeticExprLexer$DFA6"/>
            <Class name="org.killbill.billing.plugin.analytics.reports.KillBillArithmeticExprParser"/>
        </Or>
    </Match>
</FindBugsFilter>
