<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kill-bill.billing</groupId>
        <artifactId>killbill-oss-parent</artifactId>
        <version>0.147.21-SNAPSHOT</version>
        <relativePath>../killbill-oss-parent/pom.xml</relativePath>
    </parent>
    <artifactId>killbill-lpr</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LPR (Lightweight Plugin Runtime)</name>
    <description>Self-contained plugin runtime replacing Apache Felix / OSGi: ClassLoader isolation,
        service registry and a lifecycle state machine -- and nothing else from the OSGi spec.</description>

    <!--
      Layering (see CLAUDE.md, constraint A1). The dependency direction is one-way:

          lpr-api        plugin-facing contracts. Depends on nothing.
             ^
          lpr-spi        infrastructure ports. Never depends on an adapter.
             ^
          lpr-core       runtime. Programs against lpr-spi, MUST NOT depend on any adapter
             ^           or on any concrete third-party infrastructure library.
             |
          adapters       lpr-classloader-default (shipping default)
                         lpr-classloader-sofaark (proves the port is real; also a fallback)

      The ClassLoader port was proven first (design doc v1, section 58: order by risk, not by
      layer). lpr-classloader-default passes both the isolation and the unloadability tests, so
      lpr-core can now be built on top of a boundary that is known to hold.
    -->
    <modules>
        <module>lpr-api</module>
        <module>lpr-spi</module>
        <module>lpr-core</module>
        <module>lpr-classloader-default</module>
        <module>lpr-descriptor-yaml</module>
        <module>lpr-management</module>
        <module>lpr-testkit</module>
    </modules>
</project>
