<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kill-bill.billing</groupId>
        <artifactId>killbill-lpr</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>killbill-lpr-testkit</artifactId>
    <packaging>jar</packaging>
    <name>LPR :: TestKit</name>
    <description>Runs a real plugin runtime over a temporary directory so a plugin can be exercised
        the way it will actually be loaded: compiled, packaged, described, discovered, started.
        Used both by the runtime's own end-to-end tests and by plugin authors.

        This is the one module allowed to depend on adapters as well as the runtime: assembling a
        working stack is precisely its job.</description>

    <dependencies>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-classloader-default</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-descriptor-yaml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-lpr-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
