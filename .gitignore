# Maven build output
target/

# Produced by maven-shade-plugin at package time; regenerated on every build and
# differs from the pom that is actually edited.
dependency-reduced-pom.xml

# Generated sources (OpenAPI client, jOOQ) -- regenerated by the build
**/generated-sources/
**/generated-test-sources/

# IDE
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs and local scratch
*.log
*.log.*
/logs/

# Local runtime state: plugins installed at run time land under the configured
# install dir, which defaults inside the working tree during development.
/var/
/tmp/
